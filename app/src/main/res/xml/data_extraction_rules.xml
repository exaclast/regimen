<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer (API 31+). Same exclusions as backup_rules.xml:
     per-install sync identity and the Keystore-wrapped backup key stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="regimen_device.xml" />
        <exclude domain="sharedpref" path="regimen_backup_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="regimen_device.xml" />
        <exclude domain="sharedpref" path="regimen_backup_keys.xml" />
    </device-transfer>
</data-extraction-rules>
